{
  "name": "surfay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "bun scripts/deploy.ts",
    "cf:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply surfay --local",
    "db:migrate:remote": "wrangler d1 migrations apply surfay --remote --config wrangler.production.json",
    "auth:schema": "bunx --bun auth@1.6.23 generate --config scripts/better-auth-schema.ts --output migrations/0001_better_auth.sql --yes",
    "admin:promote": "bun scripts/promote-admin.ts",
    "spots:seed-migration": "bun scripts/generate-spot-seed.ts",
    "lint": "eslint .",
    "shoreline:generate": "python scripts/generate_shoreline_exposure.py",
    "shoreline:tiles": "python scripts/generate_shoreline_tiles.py",
    "shoreline:migration": "bun scripts/generate-composite-shoreline-migration.ts",
    "bathymetry:model": "python scripts/generate_bathymetry_model.py",
    "test": "vitest run",
    "preview": "bun run build && vite preview",
    "test:data": "vitest run --config vitest.data.config.ts",
    "setup:local": "bun scripts/setup-local.ts",
    "security:scan": "python scripts/scan-secrets.py",
    "check": "bun run lint && bun run test && bun run build",
    "test:e2e": "playwright test",
    "benchmark": "bun scripts/benchmark.ts",
    "capture:readme": "bun scripts/capture-readme.ts",
    "format:admin": "prettier src/pages/AdminPage.tsx worker/admin.ts --write"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.0",
    "@types/three": "^0.184.1",
    "better-auth": "1.6.23",
    "clsx": "^2.1.1",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/workers-types": "5.20260721.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "miniflare": "4.20260721.0",
    "prettier": "3.9.10",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.10",
    "wrangler": "4.112.0"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.3"
  }
}
